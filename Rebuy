<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rebuy — маркетплейс для детей</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#02050F; --night:#0B1530; --cyan:#19D8FF; --blue:#1D6BFF;
  --sun:#FFC21A; --grape:#9B4DFF; --paper:#F3F8FF; --white:#fff;
  --text:#0E1A33; --muted:#5B6B8A; --line:#DCE6F7; --ok:#12B76A; --warn:#E5484D;
  --display:'Baloo 2','Trebuchet MS',system-ui,sans-serif;
  --body:'Nunito',system-ui,-apple-system,'Segoe UI',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);background:var(--paper);color:var(--text);line-height:1.5;-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
:focus-visible{outline:3px solid var(--sun);outline-offset:2px}
img{max-width:100%;display:block}

/* ---------- header ---------- */
.top{background:var(--ink);position:sticky;top:0;z-index:20;border-bottom:1px solid #0d1a38}
.top-in{max-width:1100px;margin:auto;display:flex;align-items:center;gap:12px;padding:8px 16px}
.top img{width:52px;height:52px;border-radius:12px}
.search{flex:1;min-width:0;position:relative}
.search input{width:100%;height:44px;border-radius:22px;border:2px solid #1b2a52;background:var(--night);color:#fff;padding:0 16px}
.search input::placeholder{color:#8fa0c8}
.search input:focus{border-color:var(--cyan);outline:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border-radius:22px;font-weight:800;transition:transform .15s,background .15s}
.btn:active{transform:scale(.97)}
.btn-main{background:linear-gradient(135deg,var(--cyan),var(--blue));color:#02122e}
.btn-sun{background:var(--sun);color:#3a2800}
.btn-ghost{background:transparent;color:#fff;border:2px solid #2a3b6b}
.btn-line{background:#fff;border:2px solid var(--line);color:var(--text)}
.btn-warn{background:#fff;border:2px solid #f4c7c9;color:var(--warn)}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.me{display:none;align-items:center;gap:8px;color:#fff;font-weight:700;white-space:nowrap}
.me .dot{width:34px;height:34px;border-radius:50%;background:var(--grape);display:grid;place-items:center;font-family:var(--display);font-size:18px}
.top-actions{display:flex;gap:8px}
@media (max-width:640px){.top-actions .hide-s{display:none}.top img{width:44px;height:44px}}

/* ---------- hero ---------- */
.hero{background:var(--ink);color:#fff;overflow:hidden}
.hero-in{max-width:1100px;margin:auto;padding:28px 16px 56px;display:grid;gap:24px;align-items:center;grid-template-columns:1.1fr .9fr}
.hero h1{font-family:var(--display);font-weight:800;font-size:clamp(34px,6vw,64px);line-height:1.02;letter-spacing:-.01em}
.hero h1 .c{color:var(--cyan)}
.hero p{margin-top:14px;color:#b9c6e6;font-size:18px;max-width:46ch}
.hero-cta{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.hero-logo{justify-self:center;width:min(360px,80%);animation:float 5s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-10px) rotate(-1.5deg)}}
@media (max-width:760px){.hero-in{grid-template-columns:1fr;padding-bottom:40px}.hero-logo{order:-1;width:200px}}
@media (prefers-reduced-motion:reduce){.hero-logo{animation:none}*{scroll-behavior:auto!important}}

.trust{background:var(--night);color:#d7e2ff}
.trust-in{max-width:1100px;margin:auto;padding:14px 16px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px;font-weight:700;font-size:15px}
.trust-in div{display:flex;gap:10px;align-items:flex-start}
.trust-in b{color:var(--sun)}
@media (max-width:760px){.trust-in{grid-template-columns:1fr}}

/* ---------- shop ---------- */
main{max-width:1100px;margin:auto;padding:28px 16px 64px}
h2{font-family:var(--display);font-size:28px;line-height:1.15}
.cats{display:flex;gap:8px;overflow-x:auto;padding:14px 0 18px;scrollbar-width:none}
.cats::-webkit-scrollbar{display:none}
.chip{flex:none;height:40px;padding:0 16px;border-radius:20px;background:#fff;border:2px solid var(--line);font-weight:800;white-space:nowrap}
.chip[aria-pressed=true]{background:var(--blue);border-color:var(--blue);color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:16px}
.card{background:#fff;border-radius:22px;overflow:hidden;text-align:left;border:2px solid transparent;box-shadow:0 2px 0 var(--line);transition:transform .15s,border-color .15s;display:flex;flex-direction:column}
.card:hover{transform:translateY(-3px);border-color:var(--cyan)}
.pic{aspect-ratio:1/1;display:grid;place-items:center;font-size:84px;position:relative;overflow:hidden}
.pic img{width:100%;height:100%;object-fit:cover}
.demo{position:absolute;left:10px;top:10px;font-size:12px;font-weight:800;background:rgba(2,5,15,.7);color:#fff;border-radius:10px;padding:2px 8px}
.card-b{padding:12px 14px 16px}
.price{font-family:var(--display);font-weight:800;font-size:22px;color:var(--blue)}
.price.swap{color:var(--grape)}
.card-b h3{font-size:16px;font-weight:800;line-height:1.25;margin:2px 0 6px}
.who{font-size:14px;color:var(--muted);display:flex;align-items:center;gap:6px}
.tick{width:16px;height:16px;border-radius:50%;background:var(--ok);color:#fff;display:inline-grid;place-items:center;font-size:11px;font-weight:900;flex:none}
.empty{grid-column:1/-1;text-align:center;padding:48px 16px;color:var(--muted)}

/* ---------- safety section ---------- */
.safe{margin-top:48px;background:var(--ink);color:#fff;border-radius:28px;padding:28px 22px}
.safe h2{color:#fff}
.safe ul{list-style:none;margin-top:16px;display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.safe li{background:var(--night);border-radius:18px;padding:14px 16px;color:#cfdaf5}
.safe li b{display:block;color:var(--cyan);font-size:17px;margin-bottom:2px}
footer{text-align:center;color:var(--muted);font-size:14px;padding:0 16px 32px}

/* ---------- modal ---------- */
.veil{position:fixed;inset:0;background:rgba(2,5,15,.72);display:none;align-items:flex-end;justify-content:center;z-index:50;padding:0}
.veil.on{display:flex}
.sheet{background:#fff;width:100%;max-width:560px;max-height:94vh;overflow:auto;border-radius:28px 28px 0 0;padding:22px 20px 24px;animation:up .22s ease-out}
@keyframes up{from{transform:translateY(40px);opacity:0}}
@media (min-width:640px){.veil{align-items:center;padding:16px}.sheet{border-radius:28px}}
.sheet-h{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}
.x{width:40px;height:40px;border-radius:50%;background:var(--paper);font-size:20px;font-weight:800;flex:none}
label{display:block;font-weight:800;margin:12px 0 6px}
.in{width:100%;height:48px;border-radius:14px;border:2px solid var(--line);padding:0 14px;background:#fff}
textarea.in{height:96px;padding:10px 14px;resize:vertical}
.in:focus{border-color:var(--blue);outline:none}
.hint{font-size:14px;color:var(--muted);margin-top:6px}
.err{color:var(--warn);font-weight:700;font-size:14px;margin-top:8px;min-height:20px}
.steps{display:flex;gap:6px;margin-bottom:14px}
.steps i{flex:1;height:6px;border-radius:3px;background:var(--line)}
.steps i.on{background:var(--cyan)}
.row{display:flex;gap:10px;margin-top:18px}
.row .btn{flex:1}
.choices{display:flex;gap:10px;margin-top:10px}
.choices button{flex:1;height:56px;border-radius:16px;border:2px solid var(--line);font-family:var(--display);font-size:24px;font-weight:800}
.choices button[aria-pressed=true]{border-color:var(--blue);background:#eaf1ff}
.codebox{background:#fff8e1;border:2px dashed var(--sun);border-radius:14px;padding:10px 14px;margin-top:10px;font-size:14px}
.codebox b{font-family:var(--display);font-size:22px;letter-spacing:.15em}
.emojis{display:flex;flex-wrap:wrap;gap:8px}
.emojis button{width:48px;height:48px;border-radius:14px;border:2px solid var(--line);font-size:26px}
.emojis button[aria-pressed=true]{border-color:var(--blue);background:#eaf1ff}

/* detail + chat */
.big{border-radius:20px;overflow:hidden;aspect-ratio:16/10;display:grid;place-items:center;font-size:110px}
.big img{width:100%;height:100%;object-fit:cover}
.tip{background:#eaf7ff;border-radius:16px;padding:12px 14px;font-size:14.5px;margin-top:14px;color:#0b3a5c}
.tip b{color:var(--blue)}
.chat{margin-top:14px;background:var(--paper);border-radius:18px;padding:12px}
.msgs{display:flex;flex-direction:column;gap:8px;min-height:64px;max-height:200px;overflow:auto;padding-bottom:4px}
.msg{align-self:flex-end;background:var(--blue);color:#fff;border-radius:16px 16px 4px 16px;padding:8px 12px;max-width:85%;word-break:break-word}
.sys{align-self:center;color:var(--muted);font-size:14px;text-align:center}
.send{display:flex;gap:8px;margin-top:8px}
.send .in{height:44px}
.send .btn{height:44px;padding:0 16px}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;padding:12px 18px;border-radius:16px;font-weight:700;opacity:0;pointer-events:none;transition:.25s;z-index:99;max-width:90vw;text-align:center}
.toast.on{opacity:1;transform:translateX(-50%)}
.sr{position:absolute;left:-9999px}
</style>
</head>
<body>

<header class="top">
  <div class="top-in">
    <img src="data:image/png;base64,
